#: crowdsourcing/admin.py:31
msgid ""
"For numeric select or numeric choice, all your options must be a number. "
"This is not a number: "
msgstr ""
"Para seleção numérica ou opção numérica, todas as suas opções devem ser um "
"número. Isso não é um número: "

#: crowdsourcing/admin.py:37
msgid "Choice type questions require a list of options."
msgstr "As questões de tipo de opção exigem uma lista de opções."

#: crowdsourcing/admin.py:43
msgid ""
"The field name must start with a letter and contain nothing but "
"alphanumerics and underscore."
msgstr ""
"O nome do campo deve começar com uma letra e não contém nada mas, exceto "
"alfanuméricos e sublinhado."

#: crowdsourcing/admin.py:147
msgid ""
"Use the 'annotation' of Text Survey Report Displays to insert arbitrary text."
msgstr ""
"Use a 'anotação' do texto de relatório da enquete para inserir texto "
"arbitrário."

#: crowdsourcing/admin.py:151
msgid ""
"Given the options you picked, you need to specify some fieldnames or this "
"Survey Report Display won't do anything."
msgstr ""
"Dadas as opções que você escolheu, precisa especificar alguns nomes de campo "
"ou este relatório de enquete não fará nada."

#: crowdsourcing/admin.py:156
msgid "An x axis only makes sense for Bar and Line graphs."
msgstr "Um eixo x só faz sentido para gráficos de barras e linhas."

#: crowdsourcing/admin.py:159
msgid "You have to specify an x-axis for bar and line graphs."
msgstr "Você precisa especificar um eixo x para gráficos barras e de linha."

#: crowdsourcing/admin.py:162
msgid "Use 'Default' for Text."
msgstr "Use 'Padrão' para Texto."

#: crowdsourcing/admin.py:165
msgid "Use 'Default' or 'Count' for Pie charts."
msgstr "Use \"Padrão\" ou \"Contagem\" para gráficos de pizza."

#: crowdsourcing/forms.py:80 crowdsourcing/forms.py:196
msgid "This field is required."
msgstr "Esse campo é obrigatório."

#: crowdsourcing/forms.py:149
msgid "Unknown video url format."
msgstr "Formato de URL de vídeo desconhecido."

#: crowdsourcing/forms.py:160
msgid ""
"We couldn't read your file. Make sure it's a .jpeg, .png, or .gif file, not "
"a .psd or other unsupported type."
msgstr ""
"Não foi possível ler seu arquivo. Certifique-se de que seja um arquivo ."
"jpeg, .png ou .gif, não a .psd ou outro tipo não suportado."

#: crowdsourcing/forms.py:303
msgid "invalid format 'app_label.model_name'"
msgstr "format inválido 'app_label.model_name'"

#: crowdsourcing/forms.py:307
msgid "invalid 'app_label'"
msgstr "'app_label' inválido"

