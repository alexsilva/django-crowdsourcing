msgid "Appears on the survey entry page."
msgstr "Aparece na página de entrada da enquete."

#: crowdsourcing/models.py:367
msgid "Question HTML"
msgstr "Questão HTML"

#: crowdsourcing/models.py:370
msgid "Label"
msgstr "Legenda"

#: crowdsourcing/models.py:371
msgid "Appears on the results page."
msgstr "Aparece na página de resultados."

#: crowdsourcing/models.py:372
msgid "Help text"
msgstr "Texto de ajuda"

#: crowdsourcing/models.py:378
msgid "Required"
msgstr "Obrigatório"

#: crowdsourcing/models.py:380
msgid ""
"Unsafe to change on live surveys. Radio button list and drop down list "
"questions will have a blank option if they aren't required."
msgstr ""
"Inseguro de mudar em enquetes ao vivo. Questões do tipo 'lista de botões de "
"rádio' e 'listas suspensas' terão uma opção em branco se não forem "
"necessárias."

#: crowdsourcing/models.py:385 crowdsourcing/models.py:389
#: crowdsourcing/models.py:1126 crowdsourcing/models.py:1128
msgid "Order"
msgstr "Ordem"

#: crowdsourcing/models.py:387
msgid " Use -1 to auto-assign."
msgstr " Use -1 para atribuir automaticamente."

#: crowdsourcing/models.py:391
msgid "Option type"
msgstr "Tipo de opção"

#: crowdsourcing/models.py:394
msgid "You must not change this field on a live survey."
msgstr "Você não deve alterar esse campo em uma enquete ao vivo."

#: crowdsourcing/models.py:396
msgid "Numeric is INT"
msgstr "Numérico é um inteiro"

#: crowdsourcing/models.py:399
msgid "Options"
msgstr "Opções"

#: crowdsourcing/models.py:403
msgid ""
"Use one option per line. On a live survey you can modify the order of these "
"options. You can, at your own risk, add new options, but you must not change "
"or remove options."
msgstr ""
"Use uma opção por linha. Em uma enquete ao vivo, você pode modificar a ordem "
"dessas opções. Você pode, por sua conta e risco, adicionar novas opções, mas "
"você não deve alterar ou remover opções."

#: crowdsourcing/models.py:409
msgid ""
"Use one icon url per line. These should line up with the options. If the "
"user's submission appears on a map, we'll use the corresponding icon on the "
"map. This field only makes sense for Radio List and Select One Choice "
"questions. Do not enter these map icons on a Location Field. For Google maps "
"use 34px high by 20px wide .png images with a transparent background. You "
"can safely modify this field on live surveys."
msgstr ""

